# ---------------------------------------------------------------------------
# Jev configuration. Copy to `.env` and fill in the three items below:
#   1. QUESTIONS_FILE   - your list of questions
#   2. SLM_URL          - the small language model endpoint
#   3. LLM_PROVIDER / LLM_API_KEY - the large language model provider + key
# ---------------------------------------------------------------------------

# When true, Jev ignores QUESTIONS_FILE and uses the 3 built-in test questions.
TEST_MODE=true

# (1) Questions: YAML/JSON list or plain text (one per line).
# Placeholders: {location} and {date}
QUESTIONS_FILE=config/questions.yaml

# (2) SLM: any OpenAI-compatible chat completions endpoint
#     (Ollama, vLLM, llama.cpp server, LM Studio, TGI ...).
#     Leave blank to use the built-in rule-based router.
SLM_URL=
SLM_MODEL=phi3:mini
SLM_API_KEY=
SLM_TIMEOUT_SECONDS=15

# (3) LLM: openai | anthropic | openai_compatible | none
#     "none" returns a deterministic templated answer (no key needed).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Only for LLM_PROVIDER=openai_compatible (e.g. Azure/OpenRouter/Groq gateway)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Defaults
DEFAULT_QUESTION=Is it currently hot in {location} for this time of the year?
DEFAULT_LOCATION=Austin, TX
TEMPERATURE_UNIT=fahrenheit
HISTORY_YEARS=30
HISTORY_WINDOW_DAYS=7
